{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=true"
  },
  "Cache": {
    "DistributedTtlSeconds": 30,
    "LocalTtlSeconds": 10,
    "LocalSizeLimit": 20,
    "InvalidationChannel": "product-cache-invalidation",
    "RedisInstanceName": "product-cache-demo:"
  },
  "AllowedHosts": "*"
}
